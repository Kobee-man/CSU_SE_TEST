<!-- 界面美化：原为纯黑 #ff000000，在浅色卡片上偏硬，改为统一的 text_primary。
     注意：原文件的 state_selected 分支会让 ListView 里处于 selected 状态的那一项
     标题变浅（实测首项标题发灰、对比度不足），故去掉该分支，只保留按压态。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true" android:color="@color/text_secondary" />
  <item android:color="@color/text_primary" />
</selector>
